rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cuentas de la caja (mismas que en "admins" de la base de datos).
    // Si se agrega una cuenta de administración nueva, hay que sumar su UID aquí también.
    function esAdmin() {
      return request.auth != null && request.auth.uid in [
        'C9xtMBqK75MEdownhb2ia3LcvNh2',
        'ldvPpt458TPYVPSSwMctRDBeKts2'
      ];
    }

    // Fotos de la página: cualquiera las ve; solo la caja las sube, cambia o borra.
    match /fotos/{todo=**} {
      allow read: if true;
      allow delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
